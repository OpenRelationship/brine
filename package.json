{
  "name": "brine",
  "version": "0.1.0",
  "description": "Interviews in, Gherkin out. A question tree with voice answers, Jev-judged branches, and a Cloudflare Worker to host it.",
  "type": "module",
  "license": "MIT",
  "bin": { "brine": "./bin/brine.ts" },
  "exports": {
    "./spec": "./src/spec.ts",
    "./walk": "./src/walk.ts",
    "./check": "./src/check.ts",
    "./loop": "./src/loop.ts",
    "./ledger": "./src/ledger.ts",
    "./worker": "./src/worker.ts",
    "./ui": "./src/ui/Brine.tsx",
    "./ui/brine.css": "./src/ui/brine.css"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "example": "vite --config example/vite.config.ts",
    "example:build": "vite build --config example/vite.config.ts",
    "example:worker": "wrangler dev --config example/wrangler.jsonc"
  },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "wrangler": "^4.86.0"
  }
}
