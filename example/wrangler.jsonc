{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "brine-example",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // One object per respondent holds their walk (strongly consistent). Optional: without it walks live in KV.
  "durable_objects": { "bindings": [{ "name": "BRINE_SESSIONS", "class_name": "BrineSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BrineSession"] }],
  // Passcode tries on the bare site, per IP. Optional. namespace_id is any integer unique in your account.
  "ratelimits": [{ "name": "BRINE_ENTER_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Create these once: wrangler kv namespace create BRINE; wrangler r2 bucket create brine-example-audio
  "kv_namespaces": [{ "binding": "BRINE", "id": "REPLACE_ME" }],
  "r2_buckets": [{ "binding": "BRINE_AUDIO", "bucket_name": "brine-example-audio" }]
  // Secrets: wrangler secret put OPENROUTER_API_KEY; wrangler secret put BRINE_ADMIN_TOKEN
}
